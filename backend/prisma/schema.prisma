generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolYear {
  id          String   @id @default(cuid())
  name        String   @unique
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  promotions  Promotion[]
  students    Student[]
}

model Promotion {
  id          String      @id @default(cuid())
  name        String
  schoolYearId String
  isActive    Boolean     @default(true)
  schoolYear  SchoolYear  @relation(fields: [schoolYearId], references: [id])
  students    Student[]

  @@unique([schoolYearId, name])
}

model Parent {
  id             String    @id @default(cuid())
  name           String
  primaryPhone   String?
  secondaryPhone String?
  address        String?
  notes          String?
  createdAt      DateTime  @default(now())
  students       Student[]
}

model StudentCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  students    Student[]
}

model Supporter {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  contact     String?
  type        String?
  details     String?
  createdAt   DateTime  @default(now())
  students    Student[]
}

model Student {
  id              String          @id @default(cuid())
  matricule       String          @unique
  firstName       String
  lastName        String
  postName        String?
  gender          String?
  birthDate       DateTime?
  address         String?
  internalNumber  String?
  schoolYearId    String
  promotionId     String
  categoryId      String?
  parentId        String?
  supporterId     String?
  status          StudentStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  schoolYear      SchoolYear      @relation(fields: [schoolYearId], references: [id])
  promotion       Promotion       @relation(fields: [promotionId], references: [id])
  category        StudentCategory? @relation(fields: [categoryId], references: [id])
  parent          Parent?         @relation(fields: [parentId], references: [id])
  supporter       Supporter?      @relation(fields: [supporterId], references: [id])
  fees            StudentFee[]
  payments        Payment[]
  smsLogs         SmsLog[]
}

model FeeType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  amount      Float    @default(0)
  periodicity String   @default("MONTHLY")
  isRequired  Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  fees        StudentFee[]
}

model StudentFee {
  id          String    @id @default(cuid())
  studentId   String
  feeTypeId   String
  amount      Float
  expected    Float
  paid        Float     @default(0)
  balance     Float     @default(0)
  period      String?
  status      FeeStatus @default(PENDING)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  student     Student    @relation(fields: [studentId], references: [id])
  feeType     FeeType    @relation(fields: [feeTypeId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  studentId   String
  feeTypeId   String?
  amount      Float
  period      String?
  date        DateTime
  mode        String        @default("ESPECES")
  notes       String?
  recordedBy  String
  createdAt   DateTime      @default(now())

  student     Student        @relation(fields: [studentId], references: [id])
  feeType     FeeType?       @relation(fields: [feeTypeId], references: [id])
  smsLogs     SmsLog[]
}

model StaffMember {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  role        String
  phone       String?
  address     String?
  salary      Float?
  frequency   String?
  status      String   @default("ACTIVE")
  notes       String?
  createdAt   DateTime @default(now())
  payments    StaffPayment[]
}

model StaffPayment {
  id          String    @id @default(cuid())
  staffId     String
  amount      Float
  reason      String?
  paidAt      DateTime
  recordedBy  String
  createdAt   DateTime @default(now())

  staff       StaffMember @relation(fields: [staffId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
}

model Revenue {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SmsLog {
  id          String   @id @default(cuid())
  studentId   String?
  paymentId   String?
  recipient   String
  message     String
  status      SmsStatus @default(PENDING)
  provider    String?
  externalId  String?
  error       String?
  createdAt   DateTime @default(now())

  student     Student?  @relation(fields: [studentId], references: [id])
  payment     Payment?  @relation(fields: [paymentId], references: [id])
}

enum Role {
  ADMIN
  PERCEPTEUR
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  LATE
  EXEMPT
}

enum SmsStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}
